{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/arch.txt",
    "color": {
      "1": "#eee"
    },
    "padding": {
      "top": 1,
      "bottom": 1,
      "right": 3,
      "left": 11
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "key": "╭───────────╮ ",
      "keyColor": "#eee"
    },
    {
      "type": "title",
      "key": "│  user    │",
      "color": {
        "user": "white"
      },
      "keyColor": "#eee",
      "format": "{user-name}"
    },
    {
      "type": "kernel",
      "key": "│  kernel  │",
      "keyColor": "#eee"
    },
    {
      "type": "packages",
      "format": "{} (pacman)",
      "key": "│  package │",
      "keyColor": "#eee"
    },
    {
      "type": "shell",
      "key": "│  shell   │",
      "keyColor": "#eee"
    },
    {
      "type": "disk",
      "key": "│  disk    │",
      "keyColor": "#eee",
      "format": "{size-used} / {size-total} - {filesystem}"
    },
    {
      "type": "wm",
      "key": "│  wm      │",
      "keyColor": "#eee"
    },
    {
      "type": "uptime",
      "key": "│  uptime  │",
      "keyColor": "#eee"
    },
    {
      "type": "command",
      "key": "│ 󱦟 OS Age  │",
      "keyColor": "#eee",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "custom",
      "key": "╰───────────╯",
      "keyColor": "#eee"
    },
  ]
}
