# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0d1117"

# Main text color
theme[main_fg]="#e6edf3"

# Title color for boxes
theme[title]="#e6edf3"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#58a6ff"

# Background color of selected item in processes box
theme[selected_bg]="#264f78"

# Foreground color of selected item in processes box
theme[selected_fg]="#e6edf3"

# Color of inactive/disabled text
theme[inactive_fg]="#21262d"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#8b949e"

# Background color of the percentage meters
theme[meter_bg]="#21262d"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#58a6ff"

# Cpu box outline color
theme[cpu_box]="#58a6ff"

# Memory/disks box outline color
theme[mem_box]="#3fb950"

# Net up/down box outline color
theme[net_box]="#ff7b72"

# Processes box outline color
theme[proc_box]="#bc8cff"

# Box divider line and small boxes line color
theme[div_line]="#21262d"

# Temperature graph colors
theme[temp_start]="#d29922"
theme[temp_mid]="#ff7b72"
theme[temp_end]="#ff7b72"

# CPU graph colors
theme[cpu_start]="#58a6ff"
theme[cpu_mid]="#79c0ff"
theme[cpu_end]="#3fb950"

# Mem/Disk free meter
theme[free_start]="#3fb950"
theme[free_mid]="#56d364"
theme[free_end]="#3fb950"

# Mem/Disk cached meter
theme[cached_start]="#58a6ff"
theme[cached_mid]="#79c0ff"
theme[cached_end]="#58a6ff"

# Mem/Disk available meter
theme[available_start]="#d29922"
theme[available_mid]="#e3b341"
theme[available_end]="#d29922"

# Mem/Disk used meter
theme[used_start]="#ff7b72"
theme[used_mid]="#ffa198"
theme[used_end]="#ff7b72"

# Download graph colors
theme[download_start]="#58a6ff"
theme[download_mid]="#3fb950"
theme[download_end]="#79c0ff"

# Upload graph colors
theme[upload_start]="#bc8cff"
theme[upload_mid]="#d2a8ff"
theme[upload_end]="#bc8cff"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#3fb950"
theme[process_mid]="#58a6ff"
theme[process_end]="#bc8cff"
