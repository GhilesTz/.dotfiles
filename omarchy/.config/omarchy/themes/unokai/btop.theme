
# Main background (darker than default)
theme[main_bg]="#1B1C17"

# Main text color
theme[main_fg]="#F8F8F2"

# Title color
theme[title]="#E6DB74"

# Highlight (keys)
theme[hi_fg]="#66D9EF"

# Selected item
theme[selected_bg]="#2F3129"
theme[selected_fg]="#A6E22E"

# Inactive text
theme[inactive_fg]="#5C5A4F"

# Graph text
theme[graph_text]="#E6DB74"

# Meter background
theme[meter_bg]="#2F3129"

# Process misc
theme[proc_misc]="#FD971F"   # orange accent (extra spice)

# Box outlines (very saturated)
theme[cpu_box]="#A6E22E"
theme[mem_box]="#66D9EF"
theme[net_box]="#F92672"
theme[proc_box]="#FD971F"

# Divider lines
theme[div_line]="#49483E"

# Temperature (radioactive)
theme[temp_start]="#A6E22E"
theme[temp_mid]="#FD971F"
theme[temp_end]="#F92672"

# CPU graph (electric)
theme[cpu_start]="#66D9EF"
theme[cpu_mid]="#AE81FF"
theme[cpu_end]="#F92672"

# Free (psychedelic)
theme[free_start]="#AE81FF"
theme[free_mid]="#66D9EF"
theme[free_end]="#A6E22E"

# Cached
theme[cached_start]="#66D9EF"
theme[cached_mid]="#AE81FF"
theme[cached_end]="#FD971F"

# Available
theme[available_start]="#E6DB74"
theme[available_mid]="#FD971F"
theme[available_end]="#F92672"

# Used
theme[used_start]="#A6E22E"
theme[used_mid]="#66D9EF"
theme[used_end]="#AE81FF"

# Download (hot)
theme[download_start]="#FD971F"
theme[download_mid]="#F92672"
theme[download_end]="#F92672"

# Upload (toxic)
theme[upload_start]="#A6E22E"
theme[upload_mid]="#66D9EF"
theme[upload_end]="#66D9EF"

# Process gradient (full rave)
theme[process_start]="#66D9EF"
theme[process_mid]="#AE81FF"
theme[process_end]="#F92672"

